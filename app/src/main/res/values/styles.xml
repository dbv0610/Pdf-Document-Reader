<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Text_400">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/rb_400</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="Text_600">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/rb_500</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="AdFullScreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="HeaderScreenTitle">
        <item name="uiTextColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/rb_600</item>
        <item name="android:textSize">@dimen/_14sdp</item>
    </style>

    <style name="ButtonAppStyle">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="uiBackgroundGradientEnd">@color/grdEnd</item>
        <item name="uiBackgroundGradientOrientation">left_right</item>
        <item name="uiBackgroundGradientStart">@color/grdStart</item>
        <item name="uiBackgroundGradientEnabled">true</item>
        <item name="uiTextColor">@color/white</item>
        <item name="uiCornerRadius">@dimen/_100sdp</item>
    </style>

    <style name="ScannerChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/bg_scanner_chip</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:fontFamily">@font/rb_400</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="drawableTint">#FFFFFF</item>
    </style>

</resources>
