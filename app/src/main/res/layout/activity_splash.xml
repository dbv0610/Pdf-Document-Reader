<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    tools:context=".ui.splash.SplashActivity">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/imgIconApp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@mipmap/ic_launcher_round"
        app:cardCornerRadius="@dimen/_24sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35"
        app:layout_constraintWidth_percent="0.275"
        app:strokeWidth="0dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_launcher_foreground" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/Text_600"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:text="@string/app_name"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textColor="@color/primary"
        android:textSize="@dimen/_16ssp"
        app:layout_constraintTop_toBottomOf="@id/imgIconApp" />

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/Text_400"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:text="@string/this_action_may_contain_advertising"
        android:textAlignment="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_11sdp"
        app:layout_constraintBottom_toTopOf="@id/progressIndicator" />

    <com.ui.baselib.widget.view.UiLinearProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_12sdp"
        android:indeterminate="true"
        app:gradientEndColor="@color/grdEnd"
        app:gradientStartColor="@color/grdStart"
        app:layout_constraintBottom_toTopOf="@id/flNativeAd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.66"
        app:progressIndeterminate="true"
        app:progressTrackColor="#3DF59E42"
        app:progressTrackCornerRadius="@dimen/_12sdp"
        app:progressTrackThickness="@dimen/_5sdp" />

    <FrameLayout
        android:id="@+id/flNativeAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:nativeShimmer="media_left" />

</androidx.constraintlayout.widget.ConstraintLayout>
