<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_4sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imgThumb"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_gallery_placeholder"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="104:120"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewSelected"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_gallery_image_selected"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/imgThumb"
            app:layout_constraintEnd_toEndOf="@id/imgThumb"
            app:layout_constraintStart_toStartOf="@id/imgThumb"
            app:layout_constraintTop_toTopOf="@id/imgThumb" />

        <ImageView
            android:id="@+id/imgOpenFile"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_margin="@dimen/_4sdp"
            android:background="@drawable/bg_gallery_move"
            android:padding="@dimen/_3sdp"
            android:src="@drawable/ic_app_move"
            app:layout_constraintBottom_toBottomOf="@id/imgThumb"
            app:layout_constraintEnd_toEndOf="@id/imgThumb" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
