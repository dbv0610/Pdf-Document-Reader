<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.ui.baselib.widget.layout.UiLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp"
        app:bgColor="@color/white"
        app:cornerRadius="@dimen/_18sdp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/rb_500"
            android:includeFontPadding="false"
            android:text="@string/app_name"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_14sdp" />

        <TextView
            android:id="@+id/txtMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/rb_400"
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12sdp" />

        <com.ui.baselib.widget.layout.UiLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:padding="@dimen/_4sdp"
            app:cornerRadius="@dimen/_8sdp"
            app:stColor="@color/color_d0d0d0"
            app:strokeWidth="@dimen/_1sdp">

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                android:fontFamily="@font/rb_400"
                android:hint="@string/password_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/_6sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/_13sdp" />
        </com.ui.baselib.widget.layout.UiLinearLayout>

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnOk"
            style="@style/ButtonAppStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:fontFamily="@font/rb_500"
            android:paddingVertical="@dimen/_12sdp"
            android:text="@android:string/ok"
            android:textSize="@dimen/_13sdp"
            app:bgGdOrientation="top_bottom" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/rb_400"
            android:paddingVertical="@dimen/_12sdp"
            android:text="@android:string/cancel"
            android:textAlignment="center"
            android:textColor="@color/primary"
            android:textSize="@dimen/_13sdp"
            app:cornerRadius="@dimen/_100sdp"
            app:stColor="@color/primary"
            app:strokeWidth="@dimen/_1sdp" />
    </com.ui.baselib.widget.layout.UiLinearLayout>
</FrameLayout>
