<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    tools:context=".ui.home.document.pdf.ReadPdfActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lnHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingBottom="@dimen/_6sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/lnHeaderDef"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/lnSearchData"
            app:layout_constraintStart_toStartOf="@id/lnSearchData"
            app:layout_constraintTop_toTopOf="@id/lnSearchData">

            <ImageView
                android:id="@+id/icBackApp"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_app_back"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/rb_400"
                    android:includeFontPadding="false"
                    android:paddingEnd="@dimen/_6sdp"
                    android:singleLine="true"
                    android:text="@string/pdf"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/_14sdp"
                    tools:ignore="RtlSymmetry" />

                <ImageView
                    android:id="@+id/icSearchApp"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:padding="@dimen/_2sdp"
                    android:src="@drawable/ic_app_search" />

                <ImageView
                    android:id="@+id/icAppRotate"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:padding="@dimen/_2sdp"
                    android:src="@drawable/ic_app_rotate" />

                <ImageView
                    android:id="@+id/icPdfTools"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:contentDescription="@string/pdf_tools"
                    android:padding="@dimen/_2sdp"
                    android:src="@drawable/ic_pdf_tools" />

                <ImageView
                    android:id="@+id/icAppEdit"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:padding="@dimen/_2sdp"
                    android:src="@drawable/ic_app_magic_wand" />

                <ImageView
                    android:id="@+id/icOpenTools"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:padding="@dimen/_2sdp"
                    android:src="@drawable/ic_app_more" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lnSearchData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_bg_app"
            android:clickable="false"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/icBackSearch"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_app_back" />

            <com.ui.baselib.widget.layout.UiLinearLayout
                android:id="@+id/lnSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_8sdp"
                app:uiCornerRadius="@dimen/_8sdp"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout4"
                app:uiStrokeColor="@color/color_d0d0d0"
                app:uiStrokeWidth="@dimen/_1sdp"
                tools:layout_editor_absoluteX="16dp">

                <ImageView
                    android:id="@+id/icSearchData"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:src="@drawable/ic_app_search"
                    app:tint="@color/color_495263" />

                <EditText
                    android:id="@+id/edtSearchData"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:fontFamily="@font/rb_400"
                    android:hint="@string/enter_keyword_to_search"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/_12sdp" />
            </com.ui.baselib.widget.layout.UiLinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lnPdfRead"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/background_secondary"
        android:paddingBottom="@dimen/_6sdp"
        app:layout_constraintBottom_toTopOf="@+id/rcvFrameData"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lnHeader">

        <com.reader.pdfviewer.PDFView
            android:id="@+id/pdfRead"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/background_secondary"

            android:layout_marginTop="@dimen/_6sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/txtNumberPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:text="0/0"
            android:textColor="@color/white"
            android:textSize="@dimen/_10sdp"
            app:uiBackgroundColor="#80000000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:id="@+id/lnInkToolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="@dimen/_8sdp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_6sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/lnInkColors"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginHorizontal="@dimen/_6sdp"
                    android:background="@color/reader_thumb_bg" />

                <LinearLayout
                    android:id="@+id/lnInkWidths"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icInkClose"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:contentDescription="@string/done"
                    android:padding="@dimen/_6sdp"
                    android:src="@drawable/ic_ink_close" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/icInkUndo"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:contentDescription="@string/undo"
                    android:padding="@dimen/_6sdp"
                    android:src="@drawable/ic_ink_undo" />

                <ImageView
                    android:id="@+id/icInkRedo"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:contentDescription="@string/redo"
                    android:padding="@dimen/_6sdp"
                    android:src="@drawable/ic_ink_redo" />

                <ImageView
                    android:id="@+id/icInkSave"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:contentDescription="@string/save"
                    android:padding="@dimen/_6sdp"
                    android:src="@drawable/ic_ink_save" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvFrameData"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#EDEDED"
        android:paddingVertical="@dimen/_3sdp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.135"
        android:visibility="gone"
        tools:listitem="@layout/item_pdf_thumb"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
