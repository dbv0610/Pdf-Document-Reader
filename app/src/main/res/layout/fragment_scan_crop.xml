<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/scanner_back"
            android:padding="12dp"
            android:src="@drawable/ic_app_back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/rb_500"
            android:text="@string/scanner_angle_adjustment"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.alf06.document.reader.ui.home.scanner.view.CornerAdjustView
            android:id="@+id/cornerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRotate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawablePadding="4dp"
            android:fontFamily="@font/rb_400"
            android:gravity="center"
            android:minWidth="72dp"
            android:padding="4dp"
            android:text="@string/scanner_rotate"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:drawableTint="#FFFFFF"
            app:drawableTopCompat="@drawable/ic_app_rotate" />

        <TextView
            android:id="@+id/btnRetake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawablePadding="4dp"
            android:fontFamily="@font/rb_400"
            android:gravity="center"
            android:minWidth="72dp"
            android:padding="4dp"
            android:text="@string/retake"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:drawableTint="#FFFFFF"
            app:drawableTopCompat="@drawable/ic_page_rotate" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnApply"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_scanner_primary_button"
        android:fontFamily="@font/rb_500"
        android:gravity="center"
        android:text="@string/scanner_apply"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />
</LinearLayout>
