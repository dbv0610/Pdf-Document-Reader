<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.ui.baselib.widget.layout.UiLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp"
        app:bgColor="@color/white"
        app:cornerRadius="@dimen/_18sdp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/rb_600"
            android:includeFontPadding="false"
            android:text="@string/translate_progress_title"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_15sdp" />

        <TextView
            android:id="@+id/tvPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:fontFamily="@font/rb_600"
            android:includeFontPadding="false"
            android:textAlignment="center"
            android:textColor="@color/primary"
            android:textSize="@dimen/_22sdp"
            tools:text="45%" />

        <com.ui.baselib.widget.view.UiLinearProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            app:gradientEndColor="@color/grdEnd"
            app:gradientStartColor="@color/grdStart"
            app:progressMax="100"
            app:progressTrackColor="#3DF59E42"
            app:progressTrackCornerRadius="@dimen/_12sdp"
            app:progressTrackThickness="@dimen/_6sdp" />

        <include
            android:id="@+id/stepRead"
            layout="@layout/item_translate_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp" />

        <include
            android:id="@+id/stepDownload"
            layout="@layout/item_translate_step" />

        <include
            android:id="@+id/stepTranslate"
            layout="@layout/item_translate_step" />

        <include
            android:id="@+id/stepWrite"
            layout="@layout/item_translate_step" />

        <com.ui.baselib.widget.view.UiTextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:fontFamily="@font/rb_400"
            android:paddingVertical="@dimen/_12sdp"
            android:text="@string/file_action_cancel"
            android:textAlignment="center"
            android:textColor="@color/primary"
            android:textSize="@dimen/_13sdp"
            app:cornerRadius="@dimen/_100sdp"
            app:stColor="@color/primary"
            app:strokeWidth="@dimen/_1sdp" />
    </com.ui.baselib.widget.layout.UiLinearLayout>
</FrameLayout>
